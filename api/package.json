{
  "name": "@bento/api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "migrar": "tsx src/banco/cli.ts migrar",
